;This is a comment
;Comments always consume entire lines
	
	.data
	
n		1	5
f		1	0

	.const

s1		39	"\n\rWelcome to the DLX factorial program!"
s2		18	"\n\rEnter a number: "
s3		8	"\n\rTime: "

	.text
	TR
	TGO
	ADDI R1, R0, 0

out
	SGEI 	R11, R1, 39
	BNEZ	R11, enter
	LW		R13, s1(R1)
	PCH		R13
	ADDI	R1, R1, 1
	J		out

enter
	ADDI R1, R0, 0
go
	SGEI 	R11, R1, 18
	BNEZ	R11, start
	LW		R13, s2(R1)
	PCH		R13
	ADDI	R1, R1, 1
	J		go

start
	TSP
	GD		R4
	TGO
	PD		R4
	ADDI	R13, R0, 10
	ADDI	R14, R0, 13
	PCH		R13
	PCH		R14
	;set up registers
	ADDI	R1, R0, 2 
	;loop variable
	ADDI	R2, R0, 1 
	; place to store placeholder result
	JAL 	fact
	SW   	f(R0), R2
	PD		R2
	ADD		R2, R0, R0

	printstr3
	LW		R3, s3(R2)
	PCH		R3
	ADDI	R2, R2, 1
	SLTI	R1, R2, 8
	BNEZ	R1, printstr3

	TSP
	PDU		R30
done
	J    done

fact
	PD		R4
	ADDI	R13, R0, 33
	ADDI	R14, R0, 32
	ADDI	R15, R0, 61
	PCH		R13
	PCH		R14
	PCH		R15
	PCH		R14
	;load in how many times we loop
loop

	SGT R3, R1, R4 
	BNEZ R3, fact_end         
	; branch if R1 > n
	ADDI R5, R0, 0       
	; R5 will hold the multiplication result
	ADDI R6, R0, 1       
	; R6 is the inner loop counter

multiplyloop

	SGT R7, R6, R1
	BNEZ R7, multDONE    
	; branch if we've added R2 to itself R1 times
	ADD R5, R5, R2       
	; R5 += R2
	ADDI R6, R6, 1       
	; increment counter
	J multiplyloop
multDONE
	ADD R2, R0, R5       
	; move result back to R2
	ADDI R1, R1, 1       
	; increment outer loop variable
	J loop               
	; continue outer loop

fact_end 
	JR   R31

	
	